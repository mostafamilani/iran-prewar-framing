# Copy to configs/.env only when configuring a new installation.
# The existing local configs/.env already contains the project's credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# A basename resolves inside configs/sessions/.
TELEGRAM_SESSION=western_tmu_research

# Optional; used only by Gemini framing-coding scripts.
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as a fallback.
